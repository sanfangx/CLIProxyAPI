# ==============================================================
# CLIProxyAPI TrollStore iOS 环境变量配置文件
# ==============================================================

# 1. 显式指定根证书路径 (解决纯 Go 在 iOS 缺少 /etc/ssl/cert.pem 导致 HTTPS 握手失败的问题)
SSL_CERT_FILE=./config/cacert.pem

# 2. 运行时目录与日志输出
WRITABLE_PATH=./runtime

# 3. 离线 WebUI 控制面板路径
MANAGEMENT_STATIC_PATH=./static/management.html

# 4. 监听端口与绑定接口
PORT=8317
HOST=0.0.0.0
